# Public hostname for the API, for example api.example.com
API_DOMAIN=api.example.com

# Neon/PostgreSQL connection string. Keep this file private on the VM.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

AUTH_USERNAME=admin
# Generate with: cd api && go run hashgen_tmp.go
AUTH_PASSWORD_HASH='$2a$10$replace-with-a-real-bcrypt-hash'

PORT=8080